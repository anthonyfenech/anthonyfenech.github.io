  "content": [
    {
      "from": "Fenech",
      "time": "6:15 PM",
      "text": "Have you ever heard anyone call Stumpf \"spider monkey\" as a nickname?"
    },
    {
      "from": "DET Jordan Zimmermann",
      "time": "6:15 PM",
      "text": "Who the hell is this?"
    },
    {
      "from": "Fenech",
      "time": "6:16 PM",
      "text": "Adrian"
    },
    {
      "from": "DET Jordan Zimmermann",
      "time": "6:16 PM",
      "text": "Don’t know you. Sorry"
    },
    {
      "from": "DET Jordan Zimmermann",
      "time": "6:20 PM",
      "text": "But I do know that answer"
    },
    {
      "from": "Fenech",
      "time": "6:21 PM",
      "text": "What is it"
    },
    {
      "from": "DET Jordan Zimmermann",
      "time": "6:22 PM",
      "text": "Not suppose to tell. Especially a Adrian I dont know"
    },
    {
      "from": "Fenech",
      "time": "6:29 PM",
      "text": "Well lemme know. This is Anthony Fenech from the Detroit Free Press. Not using any names"
    },
    {
      "from": "DET Jordan Zimmermann",
      "time": "6:29 PM",
      "text": "Ahhh no chance. Better chance getting something from Boyd"
    },
    {
      "from": "Fenech",
      "time": "6:30 PM",
      "text": "Ok"
    },
    {
      "from": "DET Jordan Zimmermann",
      "time": "6:34 PM",
      "text": "Or just text Stumpf. Or better yet just read the article"
    },
    {
      "from": "Fenech",
      "time": "6:36 PM",
      "text": "I did"
    }
  ]
