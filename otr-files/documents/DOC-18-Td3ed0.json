  "type": "text",
  "subjects": [],
  "content": [
    {
      "from": "Fenech",
      "time": "9:38 AM",
      "text": "Actually, I'm gonna put it out there today!"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "10:47 AM",
      "text": "As you should"
    },
    {
      "from": "Fenech",
      "time": "11:05 AM",
      "text": "Emphasized “As you should ”"
    },
    {
      "from": "Fenech",
      "time": "11:06 AM",
      "text": "Wouldn't you rather me wait since the commissioner is apparently going to be talking about this Omaha game today or tomorrow?"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "11:10 AM",
      "text": "That would be best for the readers"
    },
    {
      "from": "Fenech",
      "time": "11:11 AM",
      "text": "Ok"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "11:21 AM",
      "text": "Be prepared today"
    },
    {
      "from": "Fenech",
      "time": "11:21 AM",
      "text": "For Montreal?"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "11:23 AM",
      "text": "No not Montreal"
    },
    {
      "from": "Fenech",
      "time": "11:24 AM",
      "text": "Mize? Thought he was coming in on Monday"
    },
    {
      "from": "Fenech",
      "time": "11:40 AM",
      "text": "Questioned “Mize? Thought he was coming in on Monday”"
    },
    {
      "from": "Fenech",
      "time": "12:26 PM",
      "text": "What time"
    },
    {
      "from": "Fenech",
      "time": "12:26 PM",
      "text": "I'm about to take off"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "12:41 PM",
      "text": "Time for which? You are throwing a lot at me?"
    },
    {
      "from": "Fenech",
      "time": "12:42 PM",
      "text": "Lol"
    },
    {
      "from": "Fenech",
      "time": "12:43 PM",
      "text": "For whatever I should be prepared for."
    },
    {
      "from": "DET Ron Colangelo",
      "time": "12:49 PM",
      "text": "Lol"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "12:49 PM",
      "text": "Not announcing Montreal today"
    },
    {
      "from": "Fenech",
      "time": "12:50 PM",
      "text": "I gathered that...but for whatever it is you guys are announcing"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "12:50 PM",
      "text": "You know what it is today"
    },
    {
      "from": "Fenech",
      "time": "12:53 PM",
      "text": "Ok. What time?"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "12:55 PM",
      "text": "Early afternoon"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "12:55 PM",
      "text": "Did you read McCoskey’s story today?"
    },
    {
      "from": "Fenech",
      "time": "12:58 PM",
      "text": "Yeah. We just ran AP. I guess it's Omaha, then. You guys going to release Commish/Al quotes?"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "12:59 PM",
      "text": "Yes"
    },
    {
      "from": "Fenech",
      "time": "12:59 PM",
      "text": "Ok"
    },
    {
      "from": "Fenech",
      "time": "12:59 PM",
      "text": "Thanks for heads up"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "1:01 PM",
      "text": "Any time"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "1:02 PM",
      "text": "Overcast here"
    },
    {
      "from": "Fenech",
      "time": "2:09 PM",
      "text": "What does this Crain's report about Comerica mean"
    }
  ]
}