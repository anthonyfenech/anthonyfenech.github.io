  "content": [
    {
      "from": "Fenech",
      "time": "6:21 PM",
      "text": "You feeling ok? Brad still hasn't announced 2-3 starters"
    },
    {
      "from": "Fenech",
      "time": "6:22 PM",
      "text": "Said Sanchez might even start in rotation, after they told him yesterday he was bullpen"
    },
    {
      "from": "DET █████████████████",
      "time": "6:34 PM",
      "text": "Who is this?"
    },
    {
      "from": "DET █████████████████",
      "time": "6:35 PM",
      "text": "I got a new phone"
    },
    {
      "from": "Fenech",
      "time": "6:40 PM",
      "text": "You just can't help yourself lol"
    },
    {
      "from": "DET █████████████████",
      "time": "6:42 PM",
      "text": "Plus I didn't save your number"
    },
    {
      "from": "DET █████████████████",
      "time": "6:42 PM",
      "text": "I have an idea but not sure"
    },
    {
      "from": "Fenech",
      "time": "6:54 PM",
      "text": "███████ Fenech"
    },
    {
      "from": "DET █████████████████",
      "time": "6:57 PM",
      "text": "6 game"
    },
    {
      "from": "DET █████████████████",
      "time": "6:58 PM",
      "text": "And I broke my ankle"
    },
    {
      "from": "Fenech",
      "time": "6:58 PM",
      "text": "This guy"
    },
    {
      "from": "DET █████████████████",
      "time": "6:59 PM",
      "text": "If brad didn't say I don't want to be the first"
    },
    {
      "from": "Fenech",
      "time": "7:01 PM",
      "text": "That's fair"
    },
    {
      "from": "DET █████████████████",
      "time": "7:07 PM",
      "text": "I'm he██thy if that helps you figure anything out"
    },
    {
      "from": "Fenech",
      "time": "7:11 PM",
      "text": "Yeah, because then you'd be pitching second game"
    },
    {
      "from": "DET █████████████████",
      "time": "7:14 PM",
      "text": "You can't make that assumption"
    },
    {
      "from": "Fenech",
      "time": "7:19 PM",
      "text": "Yeah, because Norris wouldn't throw on three days rest"
    },
    {
      "from": "DET █████████████████",
      "time": "7:30 PM",
      "text": "Who says he has another start"
    },
    {
      "from": "Fenech",
      "time": "7:31 PM",
      "text": "I know. Was just thinking that"
    },
    {
      "from": "DET █████████████████",
      "time": "7:31 PM",
      "text": "Dipshit"
    },
    {
      "from": "Fenech",
      "time": "7:32 PM",
      "text": "Don’t see why he wouldn’t though"
    },
    {
      "from": "DET █████████████████",
      "time": "7:34 PM",
      "text": "I can't help you"
    }
  ]
}