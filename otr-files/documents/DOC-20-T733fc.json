      "from": "Fenech",
      "time": "2:24 PM",
      "text": "Tigers clubhouse for some event"
    },
    {
      "from": "DET ███████████████",
      "time": "2:24 PM",
      "text": "First one"
    },
    {
      "from": "DET ███████████████",
      "time": "2:24 PM",
      "text": "First ticket sales initiative"
    },
    {
      "from": "DET ███████████████",
      "time": "2:24 PM",
      "text": "Cannot remember the date though"
    },
    {
      "from": "DET ███████████████",
      "time": "2:24 PM",
      "text": "Fuck"
    },
    {
      "from": "Fenech",
      "time": "2:25 PM",
      "text": "I’ll figure it out"
    },
    {
      "from": "DET ███████████████",
      "time": "2:25 PM",
      "text": "It was the first ever ticket sales event for the new DB initiative program.  It was in the clubhouse"
    },
    {
      "from": "Fenech",
      "time": "2:27 PM",
      "text": "February or March?"
    },
    {
      "from": "Fenech",
      "time": "2:28 PM",
      "text": "March or April?"
    },
    {
      "from": "Fenech",
      "time": "3:29 PM",
      "text": "March 14"
    },
    {
      "from": "Fenech",
      "time": "3:29 PM",
      "text": "[Attachment: Image]"
    },
    {
      "from": "Fenech",
      "time": "3:29 PM",
      "text": "Tigers clubhouse"
    },
    {
      "from": "DET ███████████████",
      "time": "3:30 PM",
      "text": "That was it!!!!"
    },
    {
      "from": "Fenech",
      "time": "3:38 PM",
      "text": "14th not 28th?"
    },
    {
      "from": "DET ███████████████",
      "time": "4:04 PM",
      "text": "It was the first one"
    },
    {
      "from": "DET ███████████████",
      "time": "4:04 PM",
      "text": "So it must have been the 14"
    },
    {
      "from": "Fenech",
      "time": "4:05 PM",
      "text": "K"
    },
    {
      "from": "Fenech",
      "time": "4:45 PM",
      "text": "It’s crazy that I’m talking with one of my news editors about the best way to approach Dave Baldwin"
    },
    {
      "from": "Fenech",
      "time": "4:45 PM",
      "text": "I remember when good ol’ DB was walking his tall ass around the press box"
    },
    {
      "from": "Fenech",
      "time": "4:46 PM",
      "text": "Call me later"
    }
