  "id": "DOC-18-Tfaeaf",
  "title": "Text: DET Sam Menzin ↔ Anthony Fenech",
  "date": "2018-03-15",
  "from": "DET Sam Menzin",
  "to": "Anthony Fenech",
  "type": "text",
  "subjects": [],
  "content": [
    {
      "from": "DET Sam Menzin",
      "time": "12:23 PM",
      "text": "Ha ok I can talk to you"
    },
    {
      "from": "Fenech",
      "time": "12:23 PM",
      "text": "Ok, let's meet up in the stands for an inning during the game"
    },
    {
      "from": "DET Sam Menzin",
      "time": "12:54 PM",
      "text": "I have to scout the game can we meet up after?"
    },
    {
      "from": "Fenech",
      "time": "1:14 PM",
      "text": "Awww, would be great color for the story. I get it, though. Yeah we can"
    },
    {
      "from": "Fenech",
      "time": "3:27 PM",
      "text": "You drive here?"
    },
    {
      "from": "DET Sam Menzin",
      "time": "3:28 PM",
      "text": "Yeah with Alan and Mac."
    },
    {
      "from": "Fenech",
      "time": "3:28 PM",
      "text": "Stay in that area after the game, your scout seats behind home plate"
    },
    {
      "from": "Fenech",
      "time": "3:29 PM",
      "text": "I'll go to clubhouse then meet you there...or meet me there like 15 min after"
    },
    {
      "from": "DET Sam Menzin",
      "time": "3:29 PM",
      "text": "Alan and Mac are going to want to go directly after the game. Want to do it over a beer in Lakeland tonight?"
    },
    {
      "from": "Fenech",
      "time": "3:30 PM",
      "text": "Just tell them to wait, it won't take long."
    },
    {
      "from": "Fenech",
      "time": "3:30 PM",
      "text": "I'll tell Mac"
    },
    {
      "from": "DET Sam Menzin",
      "time": "3:31 PM",
      "text": "I’m not making them wait. It can’t wait until tonight?"
    },
    {
      "from": "Fenech",
      "time": "3:31 PM",
      "text": "Dude"
    },
    {
      "from": "Fenech",
      "time": "3:31 PM",
      "text": "It's 15 minutes!"
    },
    {
      "from": "DET Sam Menzin",
      "time": "3:31 PM",
      "text": "Ok"
    },
    {
      "from": "Fenech",
      "time": "3:31 PM",
      "text": "Trust the vision here!"
    },
    {
      "from": "DET Sam Menzin",
      "time": "3:32 PM",
      "text": "I’ll meet you in the scout seats"
    },
    {
      "from": "Fenech",
      "time": "3:32 PM",
      "text": "Cool, thanks"
    },
    {
      "from": "Fenech",
      "time": "3:50 PM",
      "text": "Heading out"
    },
    {
      "from": "DET Sam Menzin",
      "time": "3:50 PM",
      "text": "Ok"
    },
    {
      "from": "Fenech",
      "time": "11:21 PM",
      "text": "Good chat today, thanks for the time."
    },
    {
      "from": "DET Sam Menzin",
      "time": "11:21 PM",
      "text": "No problem"
    }
  ]
}