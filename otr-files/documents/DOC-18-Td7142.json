  "content": [
    {
      "from": "DET Greg Garno",
      "time": "1:02 AM",
      "text": "Gotta be up in 6 hours. Can we talk later?"
    },
    {
      "from": "Fenech",
      "time": "1:02 AM",
      "text": "Yes"
    },
    {
      "from": "Fenech",
      "time": "1:03 AM",
      "text": "Goodnight, Greg"
    },
    {
      "from": "DET Greg Garno",
      "time": "1:03 AM",
      "text": "Goodnight Anthony. We’re almost done with this godforsaken season."
    },
    {
      "from": "Fenech",
      "time": "1:03 AM",
      "text": "Can’t wait"
    },
    {
      "from": "DET Greg Garno",
      "time": "1:04 AM",
      "text": "I can because it means I get to see less of you. And that makes me sad."
    },
    {
      "from": "DET Greg Garno",
      "time": "1:04 AM",
      "text": "HOWS THAT FOR FRIENDSHIP"
    },
    {
      "from": "Fenech",
      "time": "1:04 AM",
      "text": "Makes me sad"
    },
    {
      "from": "DET Greg Garno",
      "time": "1:04 AM",
      "text": "Loved “Makes me sad”"
    },
    {
      "from": "Fenech",
      "time": "10:32 AM",
      "text": "I should’ve wrote it"
    },
    {
      "from": "DET Greg Garno",
      "time": "11:11 AM",
      "text": "You didn’t exactly have a strong source to go on"
    },
    {
      "from": "Fenech",
      "time": "11:11 AM",
      "text": "I got one before I called you"
    },
    {
      "from": "Fenech",
      "time": "11:11 AM",
      "text": "I’m pissed"
    }
  ]
}