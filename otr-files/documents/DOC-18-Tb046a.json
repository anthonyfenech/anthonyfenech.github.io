    {
      "from": "Fenech",
      "time": "2:47 PM",
      "text": "I know"
    },
    {
      "from": "DET R.J. Burgess",
      "time": "2:47 PM",
      "text": "Have you heard when he’s supposed to pitch in a game?"
    },
    {
      "from": "Fenech",
      "time": "2:50 PM",
      "text": "Not yet"
    },
    {
      "from": "DET R.J. Burgess",
      "time": "2:55 PM",
      "text": "Ok thanks. I want to get there for it if I can."
    },
    {
      "from": "Fenech",
      "time": "3:16 PM",
      "text": "Where you at? What are you doing at this time of spring"
    },
    {
      "from": "Fenech",
      "time": "3:17 PM",
      "text": "Gimme a call if you want, I'm around for a bit."
    }
