    {
      "from": "DET █████████████, Jr.",
      "time": "3:25 PM",
      "text": "On man you nailed that pic"
    },
    {
      "from": "Fenech",
      "time": "3:25 PM",
      "text": "I’ve been thinking about you all day lol"
    },
    {
      "from": "Fenech",
      "time": "3:26 PM",
      "text": "The best, though, is what the fans said. I talked to a few"
    },
    {
      "from": "DET █████████████, Jr.",
      "time": "3:26 PM",
      "text": "Dude when I started we used to go out there serving hot chocolate all night"
    },
    {
      "from": "Fenech",
      "time": "3:26 PM",
      "text": "Couldn’t have made up their quotes they were so good"
    },
    {
      "from": "Fenech",
      "time": "3:26 PM",
      "text": "Liked “Dude when I started we used to go out there serving hot chocolate all night”"
    },
    {
      "from": "DET █████████████, Jr.",
      "time": "3:31 PM",
      "text": "Did you write a story for that photo yet?"
    },
    {
      "from": "Fenech",
      "time": "3:49 PM",
      "text": "Just finishing it up"
    },
    {
      "from": "DET █████████████, Jr.",
      "time": "4:57 PM",
      "text": "Looking forward to that"
    },
    {
      "from": "DET █████████████, Jr.",
      "time": "8:00 PM",
      "text": "“7 ticket windows for 6 waiting customers” classic line"
    },
    {
      "from": "Fenech",
      "time": "8:42 PM",
      "text": "Liked ““7 ticket windows for 6 waiting customers” classic line ”"
    },
    {
      "from": "Fenech",
      "time": "8:42 PM",
      "text": "I slipped the hot chocolate in there"
    },
    {
      "from": "DET █████████████, Jr.",
      "time": "8:43 PM",
      "text": "Saw that!"
    }
  ]
