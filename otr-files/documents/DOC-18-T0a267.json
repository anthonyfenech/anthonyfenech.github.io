  "id": "DOC-18-T0a267",
  "title": "Text: DET David Chadd ↔ Anthony Fenech",
  "date": "2018-03-19",
  "from": "DET David Chadd",
  "to": "Anthony Fenech",
  "type": "text",
  "subjects": [],
  "content": [
    {
      "from": "Fenech",
      "time": "2:27 PM",
      "text": "What is your birthdate"
    },
    {
      "from": "DET David Chadd",
      "time": "2:33 PM",
      "text": "Why"
    },
    {
      "from": "Fenech",
      "time": "2:36 PM",
      "text": "Story... you joined Tigers in 04 as VP, amateur scouting and did that for 10 years before this job?"
    },
    {
      "from": "DET David Chadd",
      "time": "2:37 PM",
      "text": "Correct"
    },
    {
      "from": "DET David Chadd",
      "time": "2:42 PM",
      "text": "Correct"
    },
    {
      "from": "Fenech",
      "time": "2:49 PM",
      "text": "Questioned “What is your birthdate”"
    },
    {
      "from": "DET David Chadd",
      "time": "2:54 PM",
      "text": "I'm 52"
    },
    {
      "from": "Fenech",
      "time": "2:54 PM",
      "text": "I know"
    },
    {
      "from": "Fenech",
      "time": "2:54 PM",
      "text": "It's in the media guide"
    },
    {
      "from": "Fenech",
      "time": "2:54 PM",
      "text": "Your birthday is not"
    },
    {
      "from": "Fenech",
      "time": "4:52 PM",
      "text": "Questioned “Your birthday is not ”"
    },
    {
      "from": "Fenech",
      "time": "5:23 PM",
      "text": "What day is your birthday"
    },
    {
      "from": "Fenech",
      "time": "5:24 PM",
      "text": "I have to submit the front office bios this afternoon"
    },
    {
      "from": "DET David Chadd",
      "time": "5:26 PM",
      "text": "Don't give out my birthday nor does Bream"
    },
    {
      "from": "DET David Chadd",
      "time": "5:27 PM",
      "text": "I don't want the general public to know that"
    },
    {
      "from": "Fenech",
      "time": "5:29 PM",
      "text": "Lol what the hell"
    },
    {
      "from": "Fenech",
      "time": "5:29 PM",
      "text": "And Bream has a Baseball-Reference page"
    },
    {
      "from": "DET David Chadd",
      "time": "5:30 PM",
      "text": "No birthday"
    },
    {
      "from": "Fenech",
      "time": "5:30 PM",
      "text": "You guys are weird"
    },
    {
      "from": "Fenech",
      "time": "5:31 PM",
      "text": "Bream's birthday is going in. His fault for playing pro baseball"
    },
    {
      "from": "Fenech",
      "time": "5:32 PM",
      "text": "The designers are doing back of baseball cards with your guys experience and stuff for the cover since you guys were lame about the pictures"
    },
    {
      "from": "DET David Chadd",
      "time": "5:36 PM",
      "text": "That's cool! Just make one up"
    }
  ]
}