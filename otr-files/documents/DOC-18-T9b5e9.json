{
  "id": "DOC-18-T9b5e9",
  "title": "Text: DET Ron Colangelo ↔ Anthony Fenech",
  "date": "2018-03-27",
  "from": "DET Ron Colangelo",
  "to": "Anthony Fenech",
  "type": "text",
  "subjects": [],
  "content": [
    {
      "from": "Fenech",
      "time": "7:37 AM",
      "text": "Thanks. Westhoff?"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "8:04 AM",
      "text": "Someone else"
    },
    {
      "from": "Fenech",
      "time": "8:30 AM",
      "text": "Colangelo?"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "8:48 AM",
      "text": "Bingo"
    },
    {
      "from": "Fenech",
      "time": "8:55 AM",
      "text": "Emphasized “Bingo ”"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "12:56 PM",
      "text": "Where are you?"
    },
    {
      "from": "Fenech",
      "time": "1:10 PM",
      "text": "Game"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "1:53 PM",
      "text": "Attendance"
    },
    {
      "from": "Fenech",
      "time": "1:56 PM",
      "text": "Questioned “Attendance ”"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "1:58 PM",
      "text": "Headline is inaccurate. We are close to capacity in tickets sold. Sensationalism is rampant."
    },
    {
      "from": "DET Ron Colangelo",
      "time": "1:59 PM",
      "text": "Where's Chris T?"
    },
    {
      "from": "Fenech",
      "time": "1:59 PM",
      "text": "On our site? Saw Tony wrote about it"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "2:00 PM",
      "text": "On your site."
    },
    {
      "from": "Fenech",
      "time": "2:01 PM",
      "text": "Oh come on"
    },
    {
      "from": "Fenech",
      "time": "2:01 PM",
      "text": "There are \"plenty\" of tickets left"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "2:23 PM",
      "text": "Says who???"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "2:24 PM",
      "text": "Quantify \"plenty\""
    },
    {
      "from": "Fenech",
      "time": "2:26 PM",
      "text": "A large or sufficient amount or quantity; more than enough"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "3:21 PM",
      "text": "We are near capacity sold."
    },
    {
      "from": "Fenech",
      "time": "3:23 PM",
      "text": "Just let me know when you're sold out"
    },
    {
      "from": "Fenech",
      "time": "3:23 PM",
      "text": "I'll have it up on the web just like that"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "3:27 PM",
      "text": "I will remember that"
    },
    {
      "from": "Fenech",
      "time": "3:38 PM",
      "text": "What?"
    },
    {
      "from": "Fenech",
      "time": "3:39 PM",
      "text": "Do you want me to put that out there? Isn't it in the story already?"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "3:48 PM",
      "text": "Sorry to bother you"
    }
  ]
}