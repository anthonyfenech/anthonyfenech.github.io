  "id": "DOC-18-T05311",
  "title": "Text: DET Ron Colangelo ↔ Anthony Fenech",
  "date": "2018-03-03",
  "from": "DET Ron Colangelo",
  "to": "Anthony Fenech",
  "type": "text",
  "subjects": [],
  "content": [
    {
      "from": "Fenech",
      "time": "7:32 AM",
      "text": "Do you know what time Chris is going to talk?"
    },
    {
      "from": "Fenech",
      "time": "8:57 AM",
      "text": "Questioned “Do you know what time Chris is going to talk?”"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "9:22 AM",
      "text": "Not at this point in time"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "10:25 AM",
      "text": "Are you here?"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "10:26 AM",
      "text": "Head to the Tigers dugout"
    },
    {
      "from": "Fenech",
      "time": "10:30 AM",
      "text": "Nope, not there"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "10:35 AM",
      "text": "We will wait for you."
    },
    {
      "from": "DET Ron Colangelo",
      "time": "10:36 AM",
      "text": "How soon can you get here?"
    },
    {
      "from": "Fenech",
      "time": "10:36 AM",
      "text": "George is there"
    },
    {
      "from": "Fenech",
      "time": "10:37 AM",
      "text": "But 15 min"
    },
    {
      "from": "Fenech",
      "time": "10:39 AM",
      "text": "What's the status of getting him for a profile? I don't wanna waste those bullets here"
    },
    {
      "from": "Fenech",
      "time": "10:46 AM",
      "text": "I'm almost there, thanks...I'm keeping that stuff in my pocket"
    },
    {
      "from": "Fenech",
      "time": "10:46 AM",
      "text": "Anything you think I should ask him?"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "10:48 AM",
      "text": "Get here now"
    },
    {
      "from": "DET Ron Colangelo",
      "time": "10:48 AM",
      "text": "In front of dugout"
    },
    {
      "from": "Fenech",
      "time": "10:49 AM",
      "text": "Just go with it, don't hold it up like I'm late"
    },
    {
      "from": "Fenech",
      "time": "10:49 AM",
      "text": "And act like I'm late...George is there"
    },
    {
      "from": "Fenech",
      "time": "10:54 AM",
      "text": "I'm here"
    }
  ]
}