    {
      "from": "Fenech",
      "time": "12:08 PM",
      "text": "How many years of \"Major League experience\" including commish office do you have"
    },
    {
      "from": "Fenech",
      "time": "12:08 PM",
      "text": "For the back of your \"baseball card\""
    },
    {
      "from": "DET Jay Sartori",
      "time": "12:21 PM",
      "text": "2006-2009 at MLB (4), 2010 at WSH (1), 2011-2013 at TOR (3), 2016-2017 at DET (2).  So 10 overall."
    },
    {
      "from": "Fenech",
      "time": "12:27 PM",
      "text": "Thank you"
    },
    {
      "from": "Fenech",
      "time": "1:21 PM",
      "text": "What was your title at Apple"
    },
    {
      "from": "DET Jay Sartori",
      "time": "1:26 PM",
      "text": "Manager, App Store Entertainment & Sports (1 year)…and then Manager, App Store Operations (1 year)"
    }
  ]
}