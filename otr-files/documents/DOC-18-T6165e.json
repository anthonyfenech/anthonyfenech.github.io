    {
      "from": "Fenech",
      "time": "5:36 PM",
      "text": "Have you heard anything about Wood?"
    },
    {
      "from": "Fenech",
      "time": "6:00 PM",
      "text": "Questioned “Have you heard anything about Wood?”"
    },
    {
      "from": "DET Ben Fidelman",
      "time": "6:04 PM",
      "text": "You can ask him tomorrow"
    },
    {
      "from": "Fenech",
      "time": "6:06 PM",
      "text": "That wasn't the question"
    },
    {
      "from": "Fenech",
      "time": "6:07 PM",
      "text": "It's a yes or no question lol"
    },
    {
      "from": "DET Ben Fidelman",
      "time": "6:07 PM",
      "text": "No"
    },
    {
      "from": "Fenech",
      "time": "6:07 PM",
      "text": "I heard he injured his right index finger in a bow and arrow accident"
    },
    {
      "from": "Fenech",
      "time": "6:08 PM",
      "text": "Teaching his son how to shoot"
    },
    {
      "from": "Fenech",
      "time": "6:09 PM",
      "text": "Misfired"
    },
    {
      "from": "Fenech",
      "time": "6:09 PM",
      "text": "4 weeks-ish"
    },
    {
      "from": "Fenech",
      "time": "6:10 PM",
      "text": "Don't repeat that, though"
    },
    {
      "from": "Fenech",
      "time": "6:11 PM",
      "text": "I don't even think I'm going to do anything with it, I don't know why"
    },
    {
      "from": "Fenech",
      "time": "6:12 PM",
      "text": "But he will the story tomorrow, I'm sure"
    },
    {
      "from": "DET Ben Fidelman",
      "time": "7:01 PM",
      "text": "What time were you at the facility until today?"
    },
    {
      "from": "Fenech",
      "time": "7:03 PM",
      "text": "I'd prefer to have that conversation in person"
    },
    {
      "from": "DET Ben Fidelman",
      "time": "7:14 PM",
      "text": "That wasn't the question"
    },
    {
      "from": "Fenech",
      "time": "7:14 PM",
      "text": "Emphasized “That wasn't the question”"
    }
  ]
