    {
      "from": "Fenech",
      "time": "4:20 PM",
      "text": "Pick a time and place. Only need a half hour, can't stay out late all night. Could come by the balcony, too. Your wife here?"
    },
    {
      "from": "DET Al Avila",
      "time": "6:22 PM",
      "text": "Come now and meet me at the Grasslands Country Club"
    },
    {
      "from": "DET Al Avila",
      "time": "6:23 PM",
      "text": "We can smoke a cigar outside"
    },
    {
      "from": "DET Al Avila",
      "time": "6:23 PM",
      "text": "Overlooking the fairway"
    },
    {
      "from": "Fenech",
      "time": "6:24 PM",
      "text": "Cool"
    },
    {
      "from": "Fenech",
      "time": "6:24 PM",
      "text": "What do I tell them at the gate"
    },
    {
      "from": "DET Al Avila",
      "time": "6:25 PM",
      "text": "No gate. The restaurant/ club is to the left before the gate"
    },
    {
      "from": "Fenech",
      "time": "6:25 PM",
      "text": "Ok"
    },
    {
      "from": "Fenech",
      "time": "6:25 PM",
      "text": "I'll be there in 15 min"
    },
    {
      "from": "Fenech",
      "time": "6:25 PM",
      "text": "Just got off freeway exit"
    },
    {
      "from": "Fenech",
      "time": "6:45 PM",
      "text": "Where are you"
    },
    {
      "from": "Fenech",
      "time": "10:36 PM",
      "text": "Good times. Don't forget to call your daughter"
    },
    {
      "from": "DET Al Avila",
      "time": "10:57 PM",
      "text": "Thanks. I did"
    },
    {
      "from": "DET Al Avila",
      "time": "10:58 PM",
      "text": "[Attachment: Image]"
    },
    {
      "from": "DET Al Avila",
      "time": "10:58 PM",
      "text": "Just bought her this dog"
    },
    {
      "from": "Fenech",
      "time": "11:07 PM",
      "text": "Cute"
    }
