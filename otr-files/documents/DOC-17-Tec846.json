  "type": "text",
  "subjects": [],
  "content": [
    {
      "from": "Fenech",
      "time": "4:28 PM",
      "text": "What are you up to"
    },
    {
      "from": "DET Al Avila",
      "time": "5:18 PM",
      "text": "Home having a drink for now"
    },
    {
      "from": "Fenech",
      "time": "5:26 PM",
      "text": "These cigars aren't gonna smoke themselves"
    },
    {
      "from": "DET Al Avila",
      "time": "5:29 PM",
      "text": "Where are you"
    },
    {
      "from": "Fenech",
      "time": "5:31 PM",
      "text": "Downtown"
    },
    {
      "from": "DET Al Avila",
      "time": "5:33 PM",
      "text": "Far from me. Your with the piriquacos. I’m in Birmingham"
    },
    {
      "from": "Fenech",
      "time": "5:36 PM",
      "text": "I'll come out that way, don't have nothing to do"
    },
    {
      "from": "Fenech",
      "time": "5:36 PM",
      "text": "Just at my friends watching football"
    },
    {
      "from": "DET Al Avila",
      "time": "5:38 PM",
      "text": "Better hurry. I don’t like staying out late.  If you want to smoke a cigar, I can meet you in my back deck or at a cigar bar like Big Rock or Churchill’s. I need to eat"
    },
    {
      "from": "DET Al Avila",
      "time": "5:38 PM",
      "text": "Your a good 30 min away"
    },
    {
      "from": "Fenech",
      "time": "5:39 PM",
      "text": "It's 5:30"
    },
    {
      "from": "Fenech",
      "time": "5:39 PM",
      "text": "I'm good for wherever let me know. Churchills has good steaks I have cigars though"
    },
    {
      "from": "DET Al Avila",
      "time": "5:40 PM",
      "text": "Fine. Churchills it is"
    },
    {
      "from": "DET Al Avila",
      "time": "5:40 PM",
      "text": "I will Uber it"
    },
    {
      "from": "DET Al Avila",
      "time": "5:40 PM",
      "text": "Meet you there in 45min"
    },
    {
      "from": "DET Al Avila",
      "time": "5:41 PM",
      "text": "??"
    },
    {
      "from": "Fenech",
      "time": "5:41 PM",
      "text": "Ok"
    },
    {
      "from": "Fenech",
      "time": "6:25 PM",
      "text": "Text me when you're there"
    },
    {
      "from": "DET Al Avila",
      "time": "6:31 PM",
      "text": "I’m here where the are you"
    },
    {
      "from": "Fenech",
      "time": "6:32 PM",
      "text": "Walking in"
    },
    {
      "from": "Fenech",
      "time": "6:32 PM",
      "text": "Where are you seated"
    }
  ]
}