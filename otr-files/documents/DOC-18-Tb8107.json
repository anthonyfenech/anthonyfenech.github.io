  "content": [
    {
      "from": "Fenech",
      "time": "12:10 AM",
      "text": "Out front?"
    },
    {
      "from": "DET Steve Liddle",
      "time": "12:12 AM",
      "text": "Gardy and Al are."
    },
    {
      "from": "Fenech",
      "time": "12:12 AM",
      "text": "What are you doing"
    },
    {
      "from": "DET Steve Liddle",
      "time": "12:14 AM",
      "text": "Talking to my wife on the phone."
    },
    {
      "from": "Fenech",
      "time": "12:15 AM",
      "text": "Nice. Tell her I say hi. Come out after"
    },
    {
      "from": "DET Steve Liddle",
      "time": "12:17 AM",
      "text": "Thank you and I will tell her. I’m tired, and it’s raining. These one run games are killers. Gardy and Al were in full swing when I left them Cigars, Lighter and Cutter."
    },
    {
      "from": "Fenech",
      "time": "12:22 AM",
      "text": "Ok, I will see you tomorrow"
    }
  ]
}