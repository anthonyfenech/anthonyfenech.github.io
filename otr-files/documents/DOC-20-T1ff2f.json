    {
      "from": "DET ███████████████",
      "time": "12:13 PM",
      "text": "That's good! Fox won't answer for me"
    },
    {
      "from": "DET ███████████████",
      "time": "12:13 PM",
      "text": "Talked to McAdams"
    },
    {
      "from": "Fenech",
      "time": "1:01 PM",
      "text": "I think we might be good without Fox"
    },
    {
      "from": "Fenech",
      "time": "1:02 PM",
      "text": "I'm gonna see if I can't come up with his address and go knocking, though"
    },
    {
      "from": "Fenech",
      "time": "1:02 PM",
      "text": "He just ignored your texts? Doubt it's a coincidence"
    },
    {
      "from": "Fenech",
      "time": "5:00 PM",
      "text": "I’m going to Scot Pett’s house fuck it"
    },
    {
      "from": "Fenech",
      "time": "6:45 PM",
      "text": "Do either of them have a daughter?"
    },
    {
      "from": "DET ███████████████",
      "time": "6:57 PM",
      "text": "Fox does"
    },
    {
      "from": "DET ███████████████",
      "time": "6:58 PM",
      "text": "I believe Pett does too. But I know for sure Fox does"
    },
    {
      "from": "DET ███████████████",
      "time": "6:58 PM",
      "text": "Yeah I talked to Mike and hes not talking because he works for the Astros"
    },
    {
      "from": "DET ███████████████",
      "time": "6:59 PM",
      "text": "Fox just wont respond to me"
    },
    {
      "from": "Fenech",
      "time": "7:03 PM",
      "text": "I'm down the street from Pett’s"
    },
    {
      "from": "DET ███████████████",
      "time": "7:03 PM",
      "text": "Love it"
    },
    {
      "from": "Fenech",
      "time": "7:03 PM",
      "text": "I'm gonna drive to Fox after"
    },
    {
      "from": "DET ███████████████",
      "time": "7:03 PM",
      "text": "Get em boy"
    },
    {
      "from": "Fenech",
      "time": "8:32 PM",
      "text": "An old lady answered the door at Fox's house, must be wrong address"
    },
    {
      "from": "Fenech",
      "time": "8:33 PM",
      "text": "But I'm driving home with Dave Baldwin's head in the backseat"
    },
    {
      "from": "DET ███████████████",
      "time": "8:35 PM",
      "text": "Hahahaaha"
    },
    {
      "from": "DET ███████████████",
      "time": "8:35 PM",
      "text": "You're fucking hilarious"
    },
    {
      "from": "DET ███████████████",
      "time": "8:35 PM",
      "text": "Did you go to Petts?"
    },
    {
      "from": "Fenech",
      "time": "9:45 PM",
      "text": "No text"
    },
    {
      "from": "Fenech",
      "time": "9:45 PM",
      "text": "Wait, that’s not what I meant to say"
    },
    {
      "from": "Fenech",
      "time": "9:45 PM",
      "text": "You know what’s up"
    },
    {
      "from": "Fenech",
      "time": "10:51 PM",
      "text": "Ron is really pissed about Roderick, I can tell"
    },
    {
      "from": "Fenech",
      "time": "10:51 PM",
      "text": "😂"
    },
    {
      "from": "Fenech",
      "time": "10:51 PM",
      "text": "He’s been ignoring me for a day on basic shit - where are the Tigers playing spring training"
    }
  ]
